/* أدوات التحقق */
function setError(id, isInvalid) {
  const field = document.getElementById(id).closest('.field');
  field.classList.toggle('invalid', isInvalid);
  return !isInvalid;
}

function validateForm() {
  let ok = true;

  const name  = document.getElementById('clientName').value.trim();
  const phone = document.getElementById('clientPhone').value.trim();
  const title = document.getElementById('projectTitle').value.trim();
  const desc  = document.getElementById('projectDesc').value.trim();
  const link  = document.getElementById('refLink').value.trim();

  ok = setError('clientName', name.length < 3) && ok;

  const digits = phone.replace(/\D/g, '');
  const phoneOk = /^[0-9+\s\-()]+$/.test(phone) && digits.length >= 10 && digits.length <= 15;
  ok = setError('clientPhone', !phoneOk) && ok;

  ok = setError('projectTitle', title.length < 3) && ok;
  ok = setError('projectDesc', desc.length < 20) && ok;

  if (link) {
    const linkOk = /^https?:\/\/.+\..+/.test(link);
    ok = setError('refLink', !linkOk) && ok;
  } else {
    setError('refLink', false);
  }

  return ok;
}

/* إزالة الخطأ أثناء الكتابة */
['clientName', 'clientPhone', 'projectTitle', 'projectDesc', 'refLink'].forEach(id => {
  const el = document.getElementById(id);
  el.addEventListener('input', () => el.closest('.field').classList.remove('invalid'));
});

/* بناء رسالة واتساب */
function buildMessage(d) {
  const lines = [];
  lines.push('*طلب مشروع جديد — ويب استوديو*');
  lines.push('--------------------------------');
  lines.push('');
  lines.push(`*اسم العميل:* ${d.name}`);
  lines.push(`*رقم واتساب:* ${d.phone}`);
  lines.push(`*عنوان المشروع:* ${d.title}`);
  lines.push('');
  lines.push('*وصف المشروع:*');
  lines.push(d.desc);

  if (d.features) {
    lines.push('');
    lines.push('*الخصائص والوظائف المطلوبة:*');
    lines.push(d.features);
  }
  if (d.style) {
    lines.push('');
    lines.push(`*أسلوب التصميم المفضل:* ${d.style}`);
  }
  if (d.refLink) {
    lines.push(`*موقع مرجعي:* ${d.refLink}`);
  }
  if (d.budget) {
    lines.push(`*الميزانية التقديرية:* ${d.budget}`);
  }
  if (d.deadline) {
    lines.push(`*الموعد المتوقع للتسليم:* ${d.deadline}`);
  }
  if (d.notes) {
    lines.push('');
    lines.push('*ملاحظات إضافية:*');
    lines.push(d.notes);
  }
  if (d.fileName) {
    lines.push('');
    lines.push(`*صورة مرجعية:* ${d.fileName} (سيتم إرفاقها يدوياً في المحادثة)`);
  }

  lines.push('');
  lines.push('--------------------------------');
  lines.push('تم إرسال هذا الطلب من الموقع الإلكتروني.');

  return lines.join('\n');
}

/* إرسال النموذج */
form.addEventListener('submit', (e) => {
  e.preventDefault();

  if (!validateForm()) {
    const firstInvalid = form.querySelector('.field.invalid input, .field.invalid textarea');
    if (firstInvalid) {
