<!DOCTYPE html>
<html lang="ar" dir="rtl">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<meta name="theme-color" content="#08090B">
<title>ويب استوديو — تصميم وتطوير المواقع الإلكترونية</title>
<meta name="description" content="ويب استوديو: استوديو متخصص في تصميم وتطوير المواقع الإلكترونية للأفراد والشركات والمؤسسات. تصميم مخصص، تطوير واجهات أمامية، صفحات هبوط، وحلول رقمية متكاملة.">
<link rel="icon" href="data:image/svg+xml,%3Csvg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 48'%3E%3Crect width='48' height='48' rx='12' fill='%230A0B0D'/%3E%3Cpath d='M12.5 16.5 17 33l7-10 7 10 4.5-16.5' fill='none' stroke='%23E5B567' stroke-width='3' stroke-linecap='round' stroke-linejoin='round'/%3E%3C/svg%3E">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=IBM+Plex+Sans+Arabic:wght@300;400;500;600;700&display=swap" rel="stylesheet">

<style>
/* ============================================================
   1) الأساسيات والمتغيرات
   ============================================================ */
:root{
  --bg:#08090B;
  --bg-2:#0C0E12;
  --surface:#111419;
  --surface-2:#171B22;
  --line:rgba(255,255,255,.08);
  --line-strong:rgba(255,255,255,.17);
  --text:#F1F2F4;
  --muted:#9BA1AB;
  --accent:#E5B567;
  --accent-soft:#F3D9A6;
  --accent-deep:#C6923C;
  --wa:#25D366;
  --radius:18px;
  --radius-sm:12px;
  --max:1180px;
  --nav-h:74px;
}

*,*::before,*::after{ box-sizing:border-box; }

html{
  scroll-behavior:smooth;
  scroll-padding-top:calc(var(--nav-h) + 20px);
  -webkit-text-size-adjust:100%;
}

body{
  margin:0;
  font-family:'IBM Plex Sans Arabic','Segoe UI','Tahoma',system-ui,-apple-system,sans-serif;
  background:var(--bg);
  color:var(--text);
  line-height:1.75;
  font-size:16px;
  overflow-x:hidden;
  -webkit-font-smoothing:antialiased;
  -moz-osx-font-smoothing:grayscale;
}

body::before{
  content:"";
  position:fixed;
  inset:0;
  pointer-events:none;
  z-index:0;
  background:
    radial-gradient(900px 520px at 85% -8%, rgba(229,181,103,.11), transparent 62%),
    radial-gradient(760px 460px at 5% 12%, rgba(120,150,255,.07), transparent 60%);
}

img{ max-width:100%; display:block; }
a{ color:inherit; text-decoration:none; }
button,input,select,textarea{ font-family:inherit; font-size:inherit; color:inherit; }
h1,h2,h3,h4,p,ul{ margin:0; }
ul{ list-style:none; padding:0; }

::selection{ background:rgba(229,181,103,.28); color:#fff; }

:focus-visible{
  outline:2px solid var(--accent);
  outline-offset:3px;
  border-radius:6px;
}

.container{
  width:100%;
  max-width:var(--max);
  margin-inline:auto;
  padding-inline:22px;
  position:relative;
  z-index:1;
}

section{ padding:96px 0; position:relative; }

/* ============================================================
   2) عناصر مشتركة
   ============================================================ */
.eyebrow{
  display:inline-flex;
  align-items:center;
  gap:9px;
  padding:7px 15px;
  border-radius:999px;
  background:rgba(229,181,103,.09);
  border:1px solid rgba(229,181,103,.24);
  color:var(--accent-soft);
  font-size:13px;
  font-weight:500;
  letter-spacing:.2px;
}
.eyebrow .dot-live{
  width:7px;height:7px;border-radius:50%;
  background:var(--accent);
  box-shadow:0 0 0 4px rgba(229,181,103,.16);
  animation:pulse 2.4s ease-in-out infinite;
}
@keyframes pulse{
  0%,100%{ box-shadow:0 0 0 3px rgba(229,181,103,.16); }
  50%{ box-shadow:0 0 0 7px rgba(229,181,103,.05); }
}

.section-head{
  max-width:700px;
  margin-bottom:52px;
}
.section-head h2{
  font-size:clamp(28px,4.2vw,42px);
  font-weight:700;
  line-height:1.35;
  margin:18px 0 14px;
  letter-spacing:-.4px;
}
.section-head p{
  color:var(--muted);
  font-size:16.5px;
  font-weight:300;
}
.section-head.center{
  margin-inline:auto;
  text-align:center;
}

.grad{
  background:linear-gradient(115deg,var(--accent-soft),var(--accent) 45%,var(--accent-deep));
  -webkit-background-clip:text;
  background-clip:text;
  color:transparent;
}

.btn{
  display:inline-flex;
  align-items:center;
  justify-content:center;
  gap:9px;
  padding:14px 28px;
  border-radius:999px;
  font-size:15px;
  font-weight:600;
  border:1px solid transparent;
  cursor:pointer;
  white-space:nowrap;
  transition:transform .22s ease, box-shadow .22s ease, background .22s ease, border-color .22s ease, color .22s ease;
}
.btn svg{ width:18px; height:18px; flex:none; }
.btn-primary{
  background:linear-gradient(135deg,var(--accent-soft),var(--accent) 55%,var(--accent-deep));
  color:#141007;
  box-shadow:0 12px 30px -14px rgba(229,181,103,.95);
}
.btn-primary:hover{ transform:translateY(-2px); box-shadow:0 18px 40px -14px rgba(229,181,103,1); }
.btn-ghost{
  background:rgba(255,255,255,.02);
  border-color:var(--line-strong);
  color:var(--text);
}
.btn-ghost:hover{ border-color:rgba(229,181,103,.6); color:var(--accent-soft); transform:translateY(-2px); }
.btn-wa{
  background:var(--wa);
  color:#04170B;
  box-shadow:0 12px 28px -14px rgba(37,211,102,.9);
}
.btn-wa:hover{ transform:translateY(-2px); box-shadow:0 18px 36px -14px rgba(37,211,102,1); }
.btn:active{ transform:translateY(0) scale(.985); }

/* حركة الظهور عند التمرير */
.reveal{
  opacity:0;
  transform:translateY(26px);
  transition:opacity .75s cubic-bezier(.22,.8,.3,1), transform .75s cubic-bezier(.22,.8,.3,1);
  will-change:opacity, transform;
}
.reveal.in{ opacity:1; transform:none; }

@media (prefers-reduced-motion:reduce){
  html{ scroll-behavior:auto; }
  *,*::before,*::after{ animation-duration:.001ms !important; transition-duration:.001ms !important; }
  .reveal{ opacity:1; transform:none; }
}

/* ============================================================
   3) شريط التنقل
   ============================================================ */
.nav{
  position:fixed;
  inset-block-start:0;
  inset-inline:0;
  height:var(--nav-h);
  z-index:120;
  display:flex;
  align-items:center;
  transition:background .3s ease, border-color .3s ease, backdrop-filter .3s ease;
  border-bottom:1px solid transparent;
}
.nav.scrolled{
  background:rgba(8,9,11,.82);
  backdrop-filter:blur(18px) saturate(140%);
  -webkit-backdrop-filter:blur(18px) saturate(140%);
  border-bottom-color:var(--line);
}
.nav-inner{
  width:100%;
  max-width:var(--max);
  margin-inline:auto;
  padding-inline:22px;
  display:flex;
  align-items:center;
  gap:26px;
}

.brand{
  display:flex;
  align-items:center;
  gap:11px;
  flex:none;
}
.brand-mark{
  width:42px;height:42px;
  color:var(--accent);
  flex:none;
  transition:transform .4s cubic-bezier(.3,1.4,.5,1);
}
.brand:hover .brand-mark{ transform:rotate(-8deg) scale(1.05); }
.brand-text{ display:flex; flex-direction:column; line-height:1.15; }
.brand-text strong{ font-size:19px; font-weight:700; letter-spacing:-.3px; }
.brand-text span{
  font-size:10.5px;
  letter-spacing:2.6px;
  color:var(--muted);
  font-weight:500;
  text-transform:uppercase;
}

.nav-links{
  display:flex;
  align-items:center;
  gap:4px;
  margin-inline-start:auto;
}
.nav-links a{
  position:relative;
  padding:9px 15px;
  font-size:14.5px;
  font-weight:500;
  color:var(--muted);
  border-radius:10px;
  transition:color .2s ease, background .2s ease;
}
.nav-links a:hover{ color:var(--text); background:rgba(255,255,255,.04); }
.nav-links a.active{ color:var(--accent-soft); }
.nav-links a.active::after{
  content:"";
  position:absolute;
  inset-block-end:2px;
  inset-inline:15px;
  height:2px;
  border-radius:2px;
  background:linear-gradient(90deg,transparent,var(--accent),transparent);
}
.nav-cta{ margin-inline-start:10px; padding:11px 22px; font-size:14px; }

.nav-toggle{
  display:none;
  width:44px;height:44px;
  border-radius:12px;
  background:rgba(255,255,255,.04);
  border:1px solid var(--line);
  cursor:pointer;
  padding:0;
  align-items:center;
  justify-content:center;
  margin-inline-start:auto;
  flex:none;
}
.nav-toggle span{
  display:block;
  width:19px;height:2px;
  background:var(--text);
  border-radius:2px;
  position:relative;
  transition:transform .3s ease, opacity .3s ease;
}
.nav-toggle span::before,
.nav-toggle span::after{
  content:"";
  position:absolute;
  inset-inline-start:0;
  width:19px;height:2px;
  background:var(--text);
  border-radius:2px;
  transition:transform .3s ease;
}
.nav-toggle span::before{ top:-6px; }
.nav-toggle span::after{ top:6px; }
.nav-toggle.open span{ background:transparent; }
.nav-toggle.open span::before{ transform:translateY(6px) rotate(45deg); }
.nav-toggle.open span::after{ transform:translateY(-6px) rotate(-45deg); }

/* ============================================================
   4) الواجهة الرئيسية (Hero)
   ============================================================ */
.hero{
  padding-block:calc(var(--nav-h) + 76px) 96px;
  overflow:hidden;
}
.hero-grid{
  display:grid;
  grid-template-columns:1.05fr .95fr;
  gap:56px;
  align-items:center;
}
.hero h1{
  font-size:clamp(32px,5.4vw,56px);
  font-weight:700;
  line-height:1.28;
  letter-spacing:-1.4px;
  margin:22px 0 20px;
}
.hero .lead{
  color:var(--muted);
  font-size:17px;
  font-weight:300;
  max-width:540px;
  line-height:1.85;
}
.hero-actions{
  display:flex;
  flex-wrap:wrap;
  gap:13px;
  margin-top:34px;
}
.hero-points{
  display:flex;
  flex-wrap:wrap;
  gap:10px 24px;
  margin-top:34px;
  padding-top:26px;
  border-top:1px solid var(--line);
}
.hero-points li{
  display:flex;
  align-items:center;
  gap:8px;
  font-size:14px;
  color:var(--muted);
  font-weight:400;
}
.hero-points svg{ width:16px;height:16px;color:var(--accent);flex:none; }

/* معاينة المتصفح */
.hero-visual{ position:relative; }
.mock{
  position:relative;
  border-radius:20px;
  background:linear-gradient(165deg,#171B22,#0D1015);
  border:1px solid var(--line-strong);
  box-shadow:0 40px 90px -40px rgba(0,0,0,.95), 0 0 0 1px rgba(255,255,255,.02) inset;
  overflow:hidden;
  animation:floaty 7s ease-in-out infinite;
}
@keyframes floaty{
  0%,100%{ transform:translateY(0); }
  50%{ transform:translateY(-12px); }
}
.mock-bar{
  display:flex;
  align-items:center;
  gap:7px;
  padding:13px 16px;
  border-bottom:1px solid var(--line);
  background:rgba(255,255,255,.02);
}
.mock-bar i{
  width:9px;height:9px;border-radius:50%;
  background:rgba(255,255,255,.14);
}
.mock-bar i:first-child{ background:rgba(229,181,103,.75); }
.mock-url{
  margin-inline-start:12px;
  flex:1;
  height:22px;
  border-radius:6px;
  background:rgba(255,255,255,.05);
  display:flex;
  align-items:center;
  padding-inline:10px;
  font-size:10.5px;
  color:var(--muted);
  letter-spacing:.6px;
  direction:ltr;
  text-align:left;
  justify-content:flex-start;
}
.mock-screen{ padding:20px; display:flex; flex-direction:column; gap:14px; }

.m-nav{ display:flex; align-items:center; gap:8px; }
.m-nav .logo-dot{ width:24px;height:9px;border-radius:3px;background:var(--accent); }
.m-nav i{ width:26px;height:6px;border-radius:3px;background:rgba(255,255,255,.13); }
.m-nav .pill{ margin-inline-start:auto; width:52px;height:20px;border-radius:999px;background:rgba(229,181,103,.22);border:1px solid rgba(229,181,103,.4); }

.m-hero{ padding:16px 0 4px; }
.m-title{ height:15px; border-radius:5px; background:linear-gradient(90deg,rgba(255,255,255,.72),rgba(255,255,255,.3)); width:74%; margin-bottom:9px; }
.m-title.short{ width:46%; }
.m-sub{ height:7px; border-radius:4px; background:rgba(255,255,255,.13); width:88%; margin-top:13px; }
.m-sub.short{ width:62%; margin-top:7px; }
.m-btns{ display:flex; gap:9px; margin-top:18px; }
.m-btns span{ width:74px;height:24px;border-radius:999px;background:var(--accent); opacity:.92; }
.m-btns span.ghost{ background:transparent; border:1px solid rgba(255,255,255,.22); }

.m-cards{ display:grid; grid-template-columns:repeat(3,1fr); gap:10px; margin-top:8px; }
.m-cards div{
  height:62px;
  border-radius:11px;
  background:linear-gradient(160deg,rgba(255,255,255,.08),rgba(255,255,255,.02));
  border:1px solid rgba(255,255,255,.06);
}
.m-cards div:nth-child(2){ background:linear-gradient(160deg,rgba(229,181,103,.22),rgba(229,181,103,.04)); border-color:rgba(229,181,103,.25); }

.float-card{
  position:absolute;
  display:flex;
  align-items:center;
  gap:9px;
  padding:11px 15px;
  border-radius:14px;
  background:rgba(19,22,28,.92);
  border:1px solid var(--line-strong);
  backdrop-filter:blur(12px);
  -webkit-backdrop-filter:blur(12px);
  font-size:12.5px;
  font-weight:500;
  box-shadow:0 22px 46px -22px rgba(0,0,0,.9);
  white-space:nowrap;
  z-index:2;
}
.float-card svg{ width:17px;height:17px;color:var(--accent);flex:none; }
.fc-1{ inset-block-start:-18px; inset-inline-start:-14px; animation:floaty 6s ease-in-out infinite .6s; }
.fc-2{ inset-block-end:-18px; inset-inline-end:-10px; animation:floaty 6.6s ease-in-out infinite .3s; }

/* ============================================================
   5) الخدمات
   ============================================================ */
.services{ background:linear-gradient(180deg,transparent,rgba(255,255,255,.014) 40%,transparent); }
.services-grid{
  display:grid;
  grid-template-columns:repeat(3,1fr);
  gap:20px;
}
.service-card{
  position:relative;
  padding:32px 28px;
  border-radius:var(--radius);
  background:linear-gradient(170deg,rgba(255,255,255,.045),rgba(255,255,255,.012));
  border:1px solid var(--line);
  overflow:hidden;
  transition:transform .3s ease, border-color .3s ease, background .3s ease;
}
.service-card::after{
  content:"";
  position:absolute;
  inset-block-start:-40%;
  inset-inline-end:-30%;
  width:200px;height:200px;
  border-radius:50%;
  background:radial-gradient(circle,rgba(229,181,103,.18),transparent 68%);
  opacity:0;
  transition:opacity .45s ease;
  pointer-events:none;
}
.service-card:hover{ transform:translateY(-6px); border-color:rgba(229,181,103,.34); }
.service-card:hover::after{ opacity:1; }
.service-icon{
  width:52px;height:52px;
  border-radius:14px;
  display:grid;
  place-items:center;
  background:rgba(229,181,103,.1);
  border:1px solid rgba(229,181,103,.24);
  color:var(--accent);
  margin-bottom:20px;
  transition:background .3s ease, color .3s ease;
}
.service-icon svg{ width:24px;height:24px; }
.service-card:hover .service-icon{ background:rgba(229,181,103,.2); }
.service-card h3{
  font-size:18.5px;
  font-weight:600;
  margin-bottom:9px;
  letter-spacing:-.2px;
}
.service-card p{
  font-size:14.5px;
  color:var(--muted);
  font-weight:300;
  line-height:1.8;
}

/* ============================================================
   6) المشاريع
   ============================================================ */
.filters{
  display:flex;
  flex-wrap:wrap;
  gap:9px;
  margin-bottom:34px;
}
.filter-btn{
  padding:10px 20px;
  border-radius:999px;
  background:rgba(255,255,255,.03);
  border:1px solid var(--line);
  color:var(--muted);
  font-size:14px;
  font-weight:500;
  cursor:pointer;
  transition:all .24s ease;
}
.filter-btn:hover{ color:var(--text); border-color:var(--line-strong); }
.filter-btn.active{
  background:linear-gradient(135deg,var(--accent-soft),var(--accent-deep));
  border-color:transparent;
  color:#141007;
  font-weight:600;
  box-shadow:0 10px 26px -14px rgba(229,181,103,.9);
}

.projects-grid{
  display:grid;
  grid-template-columns:repeat(2,1fr);
  gap:24px;
}
.project-card{
  border-radius:var(--radius);
  background:linear-gradient(170deg,rgba(255,255,255,.045),rgba(255,255,255,.012));
  border:1px solid var(--line);
  overflow:hidden;
  cursor:pointer;
  transition:transform .32s ease, border-color .32s ease, box-shadow .32s ease;
}
.project-card:hover{
  transform:translateY(-6px);
  border-color:rgba(229,181,103,.32);
  box-shadow:0 30px 60px -34px rgba(0,0,0,.95);
}
.project-card:focus-visible{ border-color:var(--accent); }

/* معاينة المشروع (مبنية بالكامل بـ CSS) */
.thumb{
  position:relative;
  aspect-ratio:16/10;
  padding:15px 15px 0;
  display:flex;
  flex-direction:column;
  gap:9px;
  border-bottom:1px solid var(--line);
  background:linear-gradient(160deg, rgba(255,255,255,.05), rgba(255,255,255,0) 55%), var(--tb,#161A21);
  overflow:hidden;
}
.thumb::before{
  content:"";
  position:absolute;
  inset-block-start:-60%;
  inset-inline-end:-20%;
  width:320px;height:320px;
  border-radius:50%;
  background:radial-gradient(circle, var(--ta,#E5B567), transparent 65%);
  opacity:.16;
  pointer-events:none;
}
.thumb-bar{ display:flex; gap:6px; position:relative; z-index:1; }
.thumb-bar i{ width:8px;height:8px;border-radius:50%;background:rgba(255,255,255,.16); }
.thumb-inner{
  position:relative;
  z-index:1;
  flex:1;
  display:flex;
  flex-direction:column;
  gap:8px;
  padding-bottom:15px;
}
.t-nav{ display:flex; align-items:center; gap:6px; }
.t-nav b{ width:26px;height:7px;border-radius:3px;background:var(--ta,#E5B567); }
.t-nav i{ width:17px;height:5px;border-radius:3px;background:rgba(255,255,255,.17); }
.t-nav u{ margin-inline-start:auto; width:30px;height:11px;border-radius:999px;background:var(--ta,#E5B567); opacity:.75; }
.t-title{ height:11px;border-radius:4px;background:rgba(255,255,255,.6);width:72%; }
.t-title.sm{ height:8px;width:44%;background:rgba(255,255,255,.26); }
.t-sub{ height:5px;border-radius:3px;background:rgba(255,255,255,.14);width:86%; }
.t-sub.sm{ width:58%; }
.t-row{ display:flex; gap:8px; margin-top:4px; }
.t-row b{ width:52px;height:15px;border-radius:999px;background:var(--ta,#E5B567); opacity:.9; }
.t-row i{ width:52px;height:15px;border-radius:999px;border:1px solid rgba(255,255,255,.22); }
.t-cards{ display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:auto; }
.t-cards span{ height:44px;border-radius:9px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.07); }
.t-cards span:nth-child(2){ background:linear-gradient(150deg, var(--ta,#E5B567), transparent 130%); opacity:.55; }
.t-block{ flex:1; border-radius:10px; background:linear-gradient(140deg,rgba(255,255,255,.11),rgba(255,255,255,.02)); border:1px solid rgba(255,255,255,.07); min-height:56px; }
.t-list{ display:flex; flex-direction:column; gap:7px; margin-top:auto; }
.t-list span{ height:14px; border-radius:5px; background:rgba(255,255,255,.075); border:1px solid rgba(255,255,255,.05); }
.t-list span:nth-child(1){ width:100%; }
.t-list span:nth-child(2){ width:82%; }
.t-list span:nth-child(3){ width:64%; }
.t-split{ display:grid; grid-template-columns:1fr 1fr; gap:10px; flex:1; align-items:center; }
.t-split .col{ display:flex; flex-direction:column; gap:7px; }

.project-info{ padding:22px 24px 26px; }
.project-cat{
  display:inline-block;
  font-size:11.5px;
  font-weight:600;
  letter-spacing:.4px;
  color:var(--accent);
  background:rgba(229,181,103,.1);
  border:1px solid rgba(229,181,103,.22);
  padding:4px 12px;
  border-radius:999px;
  margin-bottom:12px;
}
.project-info h3{
  font-size:19px;
  font-weight:600;
