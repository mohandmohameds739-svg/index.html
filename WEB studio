      واتساب — <span class="num">${n.local}</span>
    </a>
  `).join('');

  msgPreview.textContent = currentMessage;

  resultCard.classList.add('show');
  resultCard.scrollIntoView({ behavior: 'smooth', block: 'center' });
  showToast('تم تجهيز طلبك — اختر رقم واتساب');
});

/* نسخ الرسالة */
copyBtn.addEventListener('click', async () => {
  if (!currentMessage) return;
  try {
    await navigator.clipboard.writeText(currentMessage);
    showToast('تم نسخ تفاصيل الطلب');
  } catch {
    const ta = document.createElement('textarea');
    ta.value = currentMessage;
    ta.style.position = 'fixed';
    ta.style.opacity = '0';
    document.body.appendChild(ta);
    ta.select();
    try { document.execCommand('copy'); showToast('تم نسخ تفاصيل الطلب'); }
    catch { showToast('تعذّر النسخ، حاول يدوياً'); }
    document.body.removeChild(ta);
  }
});

/* تعديل الطلب */
editBtn.addEventListener('click', () => {
  document.getElementById('clientName').focus({ preventScroll: true });
  form.scrollIntoView({ behavior: 'smooth', block: 'start' });
});

/* تفريغ النموذج */
document.getElementById('resetBtn').addEventListener('click', () => {
  setTimeout(() => {
    form.querySelectorAll('.field').forEach(f => f.classList.remove('invalid'));
    fileDrop.classList.remove('has-file');
    fileNameEl.innerHTML = 'اختر صورة أو اسحبها هنا <b>(اختياري)</b>';
    resultCard.classList.remove('show');
